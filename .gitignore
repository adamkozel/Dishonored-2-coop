# Dishonored 2 Corvo/Emily co-op - deny by default.
# Only source, build files, scripts, docs and small text/JSON evidence are
# tracked; tools/repo/build_repo_manifest.py selects the evidence (256 KB cap)
# and lists the oversized files in the generated section at the end.
*
!*/
!.gitignore
!.gitattributes
!/tools/repo/pre-commit
!LICENSE
!CMakeLists.txt
!*.ps1
!*.psm1
!*.psd1
!*.py
!*.cjs
!*.js
!*.mjs
!*.ts
!*.h
!*.hpp
!*.hh
!*.inl
!*.cpp
!*.cc
!*.c
!*.cmake
!*.bat
!*.cmd
!*.sh
!*.java
!*.cs
!*.md
!*.txt
!*.json
!*.log
!*.csv
!*.html
!*.css
!*.xml
!*.yml
!*.yaml
!*.ini
!*.cfg
!*.toml

# Never committed: game copies, lab instances and save profiles, builds,
# installed tools/runtimes, Ghidra databases, game-derived assets.
/work/asset-game/
/work/lab-game/
/work/lab-instances/
/work/vm-lab/
/work/asset-install-stage/
**/build/
/work/tools/
/work/animgen-feasibility/
/work/tool-evaluation-2026-10-12/
/work/GameNetworkingSockets/
/work/Dishonored2-Debug/
**/bin/
**/assets/
**/research/
**/files/
/outputs/d2-coop-lab/analysis/ghidra/input/
*.rep/
**/profile/
**/target-*/
**/node_modules/
**/.venv/
**/__pycache__/
**/dist/

# Release packages: installer, uninstaller, manifest and README only.
/outputs/release/**/files/
/outputs/release/**/*.json
!/outputs/release/**/manifest.json
!/outputs/release/**/SUPERSEDED.json

# Archived source copies inside candidate folders (git history replaces them).
/work/movement-integration/candidate-*/src/
/work/**/catalog-before-*/
/work/movement-integration/before-*/

# Separately published dashboard snapshot (own hosting metadata).
/sites/

# Private: this take contains the SteamID and the Steam friends list.
/work/release/online-session-v1179/

