  },
  {
    "rva": "0x1c51988",
    "text": "to find health potions"
  },
  {
    "rva": "0x1c519c0",
    "text": "to get the maximum health"
  },
  {
    "rva": "0x1c519e0",
    "text": "A script didn't restore the player health lock to zero before the map transition (%i)"
  },
  {
    "rva": "0x1c60560",
    "text": "Display health/mana/breath span meters: 0 = off, 1 = fade-out when inactive, 2 = always"
  },
  {
    "rva": "0x1c7fca0",
    "text": "TELEPORT_SKILL is used with 'ARK_SKILL_TELEPORT_POSITION_DIRECTED' but we couldn't fetch the target entity '%s'. If it's not empty and valid, make sure this event is NOT used in a fastout as the target entities are already unloaded."
  },
  {
    "rva": "0x1c8a2c0",
    "text": "Must pass in an entity name to kill, optionally pass in all and an entity name to kill of of that type (does not apply to the player)"
  },
  {
    "rva": "0x1c8a4a0",
    "text": "usage: damage <name of entity to damage> <damageAmount>"
  },
  {
    "rva": "0x1c8a900",
    "text": "removes the entity with the given name, 'kill entityname' will remove that single entity, 'kill all entityname' removes all entities matching the class of the given name"
  },
  {
    "rva": "0x1c8a9b0",
    "text": "killEntity"
  },
  {
    "rva": "0x1c8af90",
    "text": "reduces damage taken based on percentage of health vs maxhealth"
  },
  {
    "rva": "0x1c8b960",
    "text": "seconds we wait after last damage to give health back to player"
  },
  {
    "rva": "0x1c8b9a0",
    "text": "g_playerHealthRegenDelay"
  },
  {
    "rva": "0x1c8b9c0",
    "text": "once regenerating health, how much we give per second"
  },
  {
    "rva": "0x1c8b9f8",
    "text": "g_playerHealthRegenRate"
  },
  {
    "rva": "0x1c8ba10",
    "text": "once regenerating health how often to increment"
  },
  {
    "rva": "0x1c8ba40",
    "text": "g_playerHealthRegenInterval"
  },
  {
    "rva": "0x1c8d020",
    "text": "enables drawing of Player Information elements in the HUD (e.g. name and health)."
