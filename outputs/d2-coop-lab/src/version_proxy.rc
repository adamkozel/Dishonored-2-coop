// #25 / #30: version resources for the release DLL (identifies the file; fewer heuristic false positives).
#include <winver.h>
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,8,0,0
 PRODUCTVERSION 0,8,0,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "adamkozel"
      VALUE "FileDescription", "Dishonored 2 Corvo/Emily co-op mod (loaded by the game as its DirectInput proxy)"
      VALUE "FileVersion", "0.8.0"
      VALUE "InternalName", "d2coop"
      VALUE "OriginalFilename", "dinput8.dll"
      VALUE "ProductName", "Dishonored 2 Corvo/Emily co-op"
      VALUE "ProductVersion", "0.8.0"
      VALUE "Comments", "https://github.com/adamkozel/Dishonored-2-coop"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
